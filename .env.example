# Supabase project (client-safe values only — the anon key is public by design;
# security comes from RLS). Leave unset to run the app on the built-in
# localStorage dev backend (no Supabase required).
#
# Dev only: production builds REQUIRE both values — `npm run build` fails
# without them, and a production bundle without them refuses to boot.
# Intentional exception: ALLOW_UNCONFIGURED_BUILD=1 npm run build
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Error reporting (Sentry). All optional — leave unset and the app runs with
# console-only error logging. The DSN is client-safe by design.
VITE_SENTRY_DSN=
# Defaults to the Vite mode (development/production); set to separate stages.
VITE_SENTRY_ENVIRONMENT=

# --- Build-time only (CI secrets, never shipped to the client): enable
# --- source-map upload so production stack traces are readable. All three
# --- required together; absent, the build skips the upload entirely. ---
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# --- Edge Function secrets (set via `supabase secrets set`, NEVER exposed to
# --- the client; listed here for documentation only) ---
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=
#
# Canva. Off unless CANVA_ENABLED=true AND a client id is present: a missing
# value hides the feature rather than breaking it. The client id and secret
# come from a Canva developer-portal integration (see README, "Canva
# integration"). The old name CANVA_AUTOBUILD_ENABLED is still honored
# during the rename.
# CANVA_ENABLED=
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=  (provided automatically inside Edge Functions)
#
# Salt for public-link rate-limit keys. A visitor's address is never stored —
# only a peppered digest of it, with one day of retention. Optional: without
# it the service role key is used instead, so the limiter is never off, but
# set it so the key is independent of a credential you may rotate.
# PUBLIC_LINK_IP_PEPPER=
