{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "node scripts/check-production-env.mjs && vite build",
    "dev": "vite",
    "preview": "vite preview --port 4273 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:deno": "deno check supabase/functions",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "shots": "node scripts/new-look/shots.mjs",
    "verify": "npm run tokens:check && npm run typecheck && npm run typecheck:deno && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-tooltip": "1.1.8",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.110.7",
    "date-fns": "3.6.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "pdfjs-dist": "6.3.289",
    "react-colorful": "5.8.1",
    "react-dropzone": "^14.3.8",
    "react-easy-crop": "^5.5.6",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "playwright-webkit-18": "npm:playwright-core@1.53.0",
    "prettier": "^3.9.6",
    "stripe": "23.0.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "6.3.5",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
